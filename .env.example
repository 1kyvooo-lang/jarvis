# Copy to .env (the installer does this for you). Never commit .env.

# Shared secret between the JARVIS backend, the Mac agent and the JARVIS MCP server.
# The installer generates a random one.
JARVIS_AGENT_TOKEN=change-me

# Optional: ElevenLabs key. Leave blank and add it in the dashboard instead
# (then it's stored in the macOS Keychain).
ELEVENLABS_API_KEY=

# Network (keep these on 127.0.0.1 — nothing here should be reachable from other machines)
JARVIS_BACKEND_HOST=127.0.0.1
JARVIS_BACKEND_PORT=8000
JARVIS_AGENT_HOST=127.0.0.1
JARVIS_AGENT_PORT=8765
JARVIS_HERMES_PORT=8642

# Optional overrides
# JARVIS_HERMES_BIN=~/.local/bin/hermes            # where the hermes command is
# JARVIS_HERMES_API_KEY=                            # if you run your own Hermes gateway
# JARVIS_APPROVAL_WAIT=240                          # seconds an action waits for your approval
# JARVIS_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
